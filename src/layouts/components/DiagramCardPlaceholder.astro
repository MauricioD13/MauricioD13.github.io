---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div
  class="relative w-full aspect-[8/5] rounded-4xl bg-light border border-border p-4 flex flex-col items-center justify-center gap-3 text-center"
>
  <svg
    width="40"
    height="40"
    viewBox="0 0 24 24"
    fill="none"
    stroke="var(--color-text-dark)"
    stroke-width="1.5"
  >
    <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
    <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
    <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
    <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
  </svg>
  <p class="text-text-light font-medium">{title}</p>
  <p class="text-text-dark text-sm">Diagram coming soon</p>
</div>
