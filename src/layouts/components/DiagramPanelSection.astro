---
// Full-screen, scroll-pinned infinite panel section for the homepage diagrams.
// Adapted from GSAP's "Layered pinning with infinite looping" demo
// (https://codepen.io/GreenSock/pen/VwbywPd) and the documented `horizontalLoop` helper
// (https://gsap.com/docs/v3/HelperFunctions/helpers/seamlessLoop/).
//
// The reference demo hijacks the *entire page's* native scroll boundaries to fake infinity
// (teleporting window.scrollTo at the very top/bottom) — that only works because in the demo
// the panels are the whole page. Here the panels are one section among several, so instead:
// a single ScrollTrigger pins this section for a fixed scroll distance (one full loop cycle,
// `panels.length * 100%` of the pinned viewport's own height) and scrubs the horizontalLoop
// timeline's progress directly off ScrollTrigger's progress. When the cycle completes,
// ScrollTrigger unpins on its own and the page continues to whatever comes next — no manual
// wheel/scroll listeners, so it rides Lenis's synced scroll (see public/scripts/animations.js)
// instead of fighting it, per CLAUDE.md "Frontend Animation Constraints".
import AwsArchitectureDiagram from "./AwsArchitectureDiagram.astro";
import DiagramCardPlaceholder from "./DiagramCardPlaceholder.astro";
---

<section class="relative" data-diagram-panels>
  <div class="relative h-dvh w-full overflow-hidden" data-panels-pin>
    <div class="flex h-full" data-panels-track>
      <div
        class="flex h-full w-full shrink-0 items-center justify-center p-6 md:p-12"
        data-panel
      >
        <AwsArchitectureDiagram />
      </div>
      <div
        class="flex h-full w-full shrink-0 items-center justify-center p-6 md:p-12"
        data-panel
      >
        <DiagramCardPlaceholder title="Multi-Region Failover Architecture" />
      </div>
      <div
        class="flex h-full w-full shrink-0 items-center justify-center p-6 md:p-12"
        data-panel
      >
        <DiagramCardPlaceholder title="Containerized Microservices on EKS" />
      </div>
    </div>

    <div
      class="absolute bottom-6 left-0 z-10 flex w-full justify-center gap-2"
      data-panel-dots
    >
      <button
        type="button"
        class="size-2 rounded-full bg-border transition-colors"
        data-panel-dot
        aria-label="Go to diagram 1"
      ></button>
      <button
        type="button"
        class="size-2 rounded-full bg-border transition-colors"
        data-panel-dot
        aria-label="Go to diagram 2"
      ></button>
      <button
        type="button"
        class="size-2 rounded-full bg-border transition-colors"
        data-panel-dot
        aria-label="Go to diagram 3"
      ></button>
    </div>
  </div>
</section>

<style>
  [data-panel-dot][aria-current="true"] {
    background: var(--color-primary);
  }
</style>

<script>
  declare const gsap: typeof import("gsap").gsap;
  declare const ScrollTrigger: typeof import("gsap/ScrollTrigger").ScrollTrigger;

  // Verbatim GSAP helper: https://gsap.com/docs/v3/HelperFunctions/helpers/seamlessLoop/
  function horizontalLoop(items: Element[], config: Record<string, any> = {}) {
    let tl = gsap.timeline({
        repeat: config.repeat,
        paused: config.paused,
        defaults: { ease: "none" },
        onReverseComplete: () =>
          tl.totalTime(tl.rawTime() + tl.duration() * 100),
      }),
      length = items.length,
      startX = (items[0] as HTMLElement).offsetLeft,
      times: number[] = [],
      widths: number[] = [],
      xPercents: number[] = [],
      curIndex = 0,
      pixelsPerSecond = (config.speed || 1) * 100,
      snap =
        config.snap === false
          ? (v: number) => v
          : gsap.utils.snap(config.snap || 1),
      totalWidth: number,
      curX: number,
      distanceToStart: number,
      distanceToLoop: number,
      item: HTMLElement,
      i: number;

    gsap.set(items, {
      xPercent: (i: number, el: HTMLElement) => {
        let w = (widths[i] = parseFloat(gsap.getProperty(el, "width", "px") as string));
        xPercents[i] = snap(
          (parseFloat(gsap.getProperty(el, "x", "px") as string) / w) * 100 +
            (gsap.getProperty(el, "xPercent") as number),
        );
        return xPercents[i];
      },
    });
    gsap.set(items, { x: 0 });
    totalWidth =
      (items[length - 1] as HTMLElement).offsetLeft +
      (xPercents[length - 1] / 100) * widths[length - 1] -
      startX +
      (items[length - 1] as HTMLElement).offsetWidth *
        (gsap.getProperty(items[length - 1], "scaleX") as number) +
      (parseFloat(config.paddingRight) || 0);

    for (i = 0; i < length; i++) {
      item = items[i] as HTMLElement;
      curX = (xPercents[i] / 100) * widths[i];
      distanceToStart = item.offsetLeft + curX - startX;
      distanceToLoop =
        distanceToStart + widths[i] * (gsap.getProperty(item, "scaleX") as number);
      tl.to(
        item,
        {
          xPercent: snap(((curX - distanceToLoop) / widths[i]) * 100),
          duration: distanceToLoop / pixelsPerSecond,
        },
        0,
      )
        .fromTo(
          item,
          {
            xPercent: snap(
              ((curX - distanceToLoop + totalWidth) / widths[i]) * 100,
            ),
          },
          {
            xPercent: xPercents[i],
            duration:
              (curX - distanceToLoop + totalWidth - curX) / pixelsPerSecond,
            immediateRender: false,
          },
          distanceToLoop / pixelsPerSecond,
        )
        .add("label" + i, distanceToStart / pixelsPerSecond);
      times[i] = distanceToStart / pixelsPerSecond;
    }

    function toIndex(index: number, vars: Record<string, any> = {}) {
      Math.abs(index - curIndex) > length / 2 &&
        (index += index > curIndex ? -length : length);
      let newIndex = gsap.utils.wrap(0, length, index),
        time = times[newIndex];
      if (time > tl.time() !== index > curIndex) {
        vars.modifiers = { time: gsap.utils.wrap(0, tl.duration()) };
        time += tl.duration() * (index > curIndex ? 1 : -1);
      }
      curIndex = newIndex;
      vars.overwrite = true;
      return tl.tweenTo(time, vars);
    }

    (tl as any).next = (vars: Record<string, any>) => toIndex(curIndex + 1, vars);
    (tl as any).previous = (vars: Record<string, any>) => toIndex(curIndex - 1, vars);
    (tl as any).current = () => curIndex;
    (tl as any).toIndex = (index: number, vars: Record<string, any>) => toIndex(index, vars);
    (tl as any).times = times;
    tl.progress(1, true).progress(0, true);
    if (config.reversed) {
      tl.vars.onReverseComplete?.();
      tl.reverse();
    }
    return tl as typeof tl & {
      next: (vars?: Record<string, any>) => gsap.core.Tween;
      previous: (vars?: Record<string, any>) => gsap.core.Tween;
      current: () => number;
      toIndex: (index: number, vars?: Record<string, any>) => gsap.core.Tween;
      times: number[];
    };
  }

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const section = document.querySelector<HTMLElement>("[data-diagram-panels]");
  const pinWrap = section?.querySelector<HTMLElement>("[data-panels-pin]");
  const track = section?.querySelector<HTMLElement>("[data-panels-track]");
  const panels = section
    ? Array.from(section.querySelectorAll<HTMLElement>("[data-panel]"))
    : [];
  const dotsWrap = section?.querySelector<HTMLElement>("[data-panel-dots]");
  const dots = section
    ? Array.from(section.querySelectorAll<HTMLButtonElement>("[data-panel-dot]"))
    : [];

  if (section && pinWrap && track && panels.length) {
    if (reduceMotion) {
      // No pin, no scrub: stack panels in normal vertical flow so the content is still
      // fully reachable via ordinary scrolling.
      pinWrap.classList.remove("h-dvh", "overflow-hidden");
      pinWrap.classList.add("h-auto");
      track.classList.remove("flex");
      track.classList.add("flex", "flex-col", "gap-16", "py-16");
      panels.forEach((panel) => {
        panel.classList.remove("h-full", "shrink-0");
        panel.classList.add("h-auto");
      });
      dotsWrap?.classList.add("hidden");
    } else {
      gsap.registerPlugin(ScrollTrigger);

      const loop = horizontalLoop(panels, { paused: true });

      const setActiveDot = (progress: number) => {
        const index = Math.min(
          panels.length - 1,
          Math.floor(progress * panels.length),
        );
        dots.forEach((dot, i) =>
          dot.setAttribute("aria-current", i === index ? "true" : "false"),
        );
      };
      setActiveDot(0);

      const trigger = ScrollTrigger.create({
        trigger: pinWrap,
        start: "top top",
        end: `+=${panels.length * 100}%`,
        pin: true,
        scrub: true,
        onUpdate: (self) => {
          loop.progress(self.progress);
          setActiveDot(self.progress);
        },
      });

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          const targetProgress = loop.times[i] / loop.duration();
          const targetY =
            trigger.start + (trigger.end - trigger.start) * targetProgress;
          const win = window as unknown as {
            lenis?: { scrollTo: (target: number, opts?: Record<string, any>) => void };
          };
          if (win.lenis) {
            win.lenis.scrollTo(targetY, { duration: 1 });
          } else {
            window.scrollTo({ top: targetY, behavior: "smooth" });
          }
        });
      });
    }
  }
</script>
