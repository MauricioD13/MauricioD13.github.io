---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_text,
  title,
}: {
  logo: string;
  logo_text: string;
  title: string;
} = config.site;

const logoSrc = src ? src : logo;

// Derive the mark's true aspect ratio from the source file rather than a hand-typed
// width/height pair — this logo is a tall, narrow icon (not a wide wordmark lockup),
// and a mismatched fixed box stretched/squashed it. Display size is controlled purely
// by the `class` below (responsive height, w-auto), so it always scales correctly.
let aspectRatio = 1;
if (logoSrc) {
  const images = import.meta.glob<{ default: { width: number; height: number } }>(
    "/public/images/**/*.{jpeg,jpg,png,gif,svg}",
  );
  const mod = images[`/public${logoSrc}`];
  if (mod) {
    const { default: meta } = await mod();
    aspectRatio = meta.width / meta.height;
  }
}

// Generate the raster at 2x the largest displayed height (see class below) for crispness
// on high-DPI screens; CSS scales it down to the actual responsive display size.
const renderHeight = 80;
const renderWidth = Math.round(renderHeight * aspectRatio);
---

<a href="/" class="navbar-brand inline-flex items-center">
  {
    logoSrc ? (
      <ImageMod
        src={logoSrc}
        class="h-8 w-auto md:h-10"
        width={renderWidth}
        height={renderHeight}
        alt={title}
        format="webp"
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
